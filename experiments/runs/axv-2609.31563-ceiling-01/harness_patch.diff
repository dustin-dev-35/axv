+            "fixed_tiebreak_N2_gain_pp": round(100 * half_bound, 3),
+            "random_tiebreak_N2_gain_pp": 0.0,
+            "paper_reported_share_of_bound_pct": "11-21 (Appendix D, Figure 3, averaged per task)",
+        })
